# Символ для анализа (формат ETHUSDT, дефисы/слэши не нужны)
SYMBOL=ETHUSDT

# Стиль анализа: scalping (узкие 1m/5m-стопы, минуты) или swing (стопы/цели
# по структуре 15m/1h, часы-сутки). Можно переопределить флагом --mode.
TRADING_MODE=scalping

# Ваша текущая позиция вручную: NONE / LONG / SHORT
POSITION=NONE
ENTRY_PRICE=
LEVERAGE=
STOP_LOSS=
TAKE_PROFIT=

# Необязательные тонкие настройки BingX
KLINE_LIMIT=220
ORDERBOOK_DEPTH=20
ORDERBOOK_DISPLAY_DEPTH=8
REQUEST_TIMEOUT=10
FUNDING_HISTORY_LIMIT=5

# Симулятор исхода прогнозов (outcome_simulator.py) — фиксированные издержки
# для перевода движения цены в R, и минимальный размер выборки для статистики
TRADING_COMMISSION_PCT=0.0005
TRADING_SLIPPAGE_PCT=0.0002
MIN_SAMPLE_FOR_STATS=3

# AI API для автоматического анализа собранных данных — до 3 моделей
# (OpenAI-совместимый chat/completions эндпоинт, например шлюз APINET.CLOUD).
# Каждая модель может быть на своём ключе/провайдере — все три опрашиваются
# параллельно, результат сравнивается в dashboard.html. Модель без ключа
# просто пропускается. Если ни один ключ не задан — либо укажите хотя бы
# один, либо всегда запускайте с флагом --no-ai.

# Модель 1 (например, OpenAI)
AI_API_KEY=
AI_BASE_URL=https://apinet.cloud/v1
AI_MODEL=gpt-4o-mini
AI_LABEL=GPT-4o mini

# Модель 2 (например, Anthropic Claude)
AI2_API_KEY=
AI2_BASE_URL=https://apinet.cloud/v1
AI2_MODEL=claude-sonnet-5
AI2_LABEL=Claude Sonnet 5

# Модель 3 (например, Google Gemini)
AI3_API_KEY=
AI3_BASE_URL=https://apinet.cloud/v1
AI3_MODEL=gemini-2.5-pro
AI3_LABEL=Gemini 2.5 Pro

AI_REQUEST_TIMEOUT=90

# Локальный сервер живого дашборда (python main.py --serve / python server.py).
# Кнопка «Обновить» в dashboard.html дёргает этот сервер, чтобы получить
# реальные свежие данные для активной вкладки, а не просто перечитать файл.
# DASHBOARD_HOST специально не 0.0.0.0 — сервер может дёргать платные AI-
# запросы и показывает вашу позицию, не открывайте его наружу без авторизации.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=47913
